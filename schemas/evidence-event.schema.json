{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheBabelDragon/dragon-gate/schemas/evidence-event.schema.json",
  "title": "DragonGateEvidenceEvent",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "node_id",
    "sequence",
    "source_timestamp",
    "ingest_timestamp",
    "clock_source",
    "observation",
    "tool_identity"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "event_id": { "type": "string" },
    "event_type": { "type": "string" },
    "node_id": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 0 },
    "source_timestamp": { "type": "number" },
    "ingest_timestamp": { "type": "number" },
    "clock_source": { "type": "string" },
    "target_identity": { "type": ["string", "null"] },
    "observation": { "type": "object" },
    "tool_identity": { "type": "string" },
    "provenance": { "type": "object" },
    "content_hash": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
